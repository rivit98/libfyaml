#
# libfyaml fuzzing dictionary  (libFuzzer -dict= / AFL++ -x)
#
# Covers the whole surface the harness in src/fuzz/main.c reaches:
#   * YAML 1.1 / 1.2 / 1.3 syntax (directives, block & flow, scalars,
#     anchors/tags, core-schema resolution, encoding edge cases)
#   * JSON (FYPCF_JSON_AUTO / FYPCF_JSON_FORCE parse flags)
#   * libfyaml ypath expressions (fy_path_expr_build_from_string, fy_path_exec)
#   * JSON pointer / relative JSON pointer (fy_node_by_path, FYNWF_PTR_*)
#   * fy_document_scanf() format fragments
#   * the packed-reflection blob header (fy_reflection_from_packed_blob)
#
# Layout note: LLVMFuzzerTestOneInput() eats the first 4 bytes as the flag
# seed, and the two-part tests split the remainder on the first '\n' - hence
# the split_* entries that carry an embedded newline.
#
# Escapes are limited to \\ \" \xNN - the only ones both libFuzzer and AFL++
# understand. Every token is <= 64 bytes (libFuzzer Word::kMaxSize).
#

# ── directives & document markers ────────────────────────────────────────────
d_yaml_11="%YAML 1.1"
d_yaml_12="%YAML 1.2"
d_yaml_13="%YAML 1.3"
d_yaml_bad="%YAML 9.9"
d_yaml_junk="%YAML 1"
d_tag_primary="%TAG ! !local-"
d_tag_secondary="%TAG !! tag:yaml.org,2002:"
d_tag_named="%TAG !e! tag:example.com,2000:app/"
d_tag_short="%TAG !m! !my-"
d_tag_bad="%TAG !"
d_unknown="%FOO bar baz"
d_percent="%"
doc_start="---"
doc_start_nl="---\x0a"
doc_start_sp="--- "
doc_end="..."
doc_end_nl="...\x0a"
doc_start_tagged="--- !!str "
doc_two="---\x0aa\x0a---\x0ab\x0a"
doc_empty="---\x0a...\x0a"

# ── block collections ────────────────────────────────────────────────────────
b_seq="- "
b_seq_bare="-\x0a"
b_seq_nested="- - "
b_key="k: "
b_key_empty="k:\x0a"
b_key_quoted="'k': "
b_key_dquoted="\"k\": "
b_explicit_key="? "
b_explicit_value=": "
b_qmark="?"
b_colon="::"
b_complex_key="? [a, b]\x0a: v\x0a"
b_complex_key_map="? {a: b}\x0a: v\x0a"
b_seq_in_map="k:\x0a- a\x0a"
b_map_in_seq="- k: v\x0a"
b_dup_key="a: 1\x0aa: 2\x0a"
b_indent2="\x0a  "
b_indent6="\x0a      "
b_tab_indent="\x0a\x09"
b_crlf="\x0d\x0a"
b_blank_line="\x0a\x0a"
b_trailing_space=" \x0a"
b_walrus="=:"
b_deep_seq="- - - - - - - - "
b_deep_map="a:\x0a b:\x0a  c:\x0a   d: 1\x0a"

# ── flow collections ─────────────────────────────────────────────────────────
f_lbracket="["
f_rbracket="]"
f_lbrace="{"
f_rbrace="}"
f_comma=","
f_seq="[a, b]"
f_map="{k: v, x: y}"
f_seq_empty="[]"
f_map_empty="{}"
f_nested="[{a: [b]}]"
f_key_only="{a}"
f_empty_value="{a: }"
f_empty_key="{: v}"
f_trailing_comma="[a,]"
f_double_comma="[,,]"
f_in_block="k: [a, b]"
f_deep_seq="[[[[[[[[]]]]]]]]"
f_deep_map="{a:{a:{a:{a:{}}}}}"
f_unterminated="[a, b"
f_multiline="[\x0a a,\x0a b\x0a]"
f_explicit_key="{? a: b}"

# ── scalar styles ────────────────────────────────────────────────────────────
s_literal="|"
s_folded=">"
s_literal_strip="|-"
s_literal_keep="|+"
s_folded_strip=">-"
s_folded_keep=">+"
s_literal_indent="|2"
s_literal_indent_keep="|2+"
s_folded_indent_strip=">1-"
s_literal_indent9="|9"
s_literal_indent10="|10"
s_literal_bad="|0"
s_literal_block="k: |\x0a  text\x0a"
s_folded_block="k: >\x0a  text\x0a"
s_literal_more_indented="|\x0a  a\x0a    b\x0a"
s_single="'a''b'"
s_single_empty="''"
s_single_open="'abc"
s_single_multiline="'a\x0a b'"
s_double="\"a\\\"b\""
s_double_empty="\"\""
s_double_open="\"abc"
s_double_multiline="\"a\x0a b\""
s_plain_colon="a:b"
s_plain_hash="a#b"
s_plain_multiline="a\x0a b\x0a"
s_indicators="-?:,[]{}#&*!|>'\"%@`"
s_reserved_at="@"
s_reserved_tick="`"

# ── double-quoted escapes ────────────────────────────────────────────────────
e_nl="\\n"
e_tab="\\t"
e_cr="\\r"
e_null="\\0"
e_bell="\\a"
e_backspace="\\b"
e_vtab="\\v"
e_formfeed="\\f"
e_escape="\\e"
e_space="\\ "
e_dquote="\\\""
e_slash="\\/"
e_backslash="\\\\"
e_nel="\\N"
e_nbsp="\\_"
e_ls="\\L"
e_ps="\\P"
e_hex="\\x41"
e_hex_bad="\\xZZ"
e_hex_short="\\x4"
e_u16="\\u2028"
e_u16_surrogate="\\ud800"
e_u16_short="\\u12"
e_u32="\\U0001F600"
e_u32_max="\\U0010FFFF"
e_u32_over="\\U7FFFFFFF"
e_continuation="\\\x0a"
e_invalid="\\q"

# ── anchors, aliases, merge keys ─────────────────────────────────────────────
a_amp="&"
a_star="*"
a_anchor="&a"
a_anchor_sp="&a "
a_anchor_named="&anchor "
a_alias="*a"
a_alias_named="*anchor"
a_alias_key="*a: v"
a_anchor_kv="&a k: v"
a_anchor_tag="&a !!str v"
a_tag_anchor="!!str &a v"
a_self_ref="&a [*a]"
a_undefined_alias="*undefined"
a_empty_anchor="&\x0a"
a_utf8_anchor="&\xc3\xa9"
a_long_anchor="&aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
a_merge="<<"
a_merge_kv="<<: *a"
a_merge_spaced="<< : *a"
a_merge_seq="<<: [*a, *b]"
a_merge_inline="<<: {a: 1}"
a_merge_tag="!!merge"
a_dup_anchor="&a 1\x0a&a 2\x0a"

# ── tags ─────────────────────────────────────────────────────────────────────
t_bang="!"
t_bangbang="!!"
t_non_specific="! "
t_str="!!str"
t_int="!!int"
t_float="!!float"
t_bool="!!bool"
t_null="!!null"
t_map="!!map"
t_seq="!!seq"
t_set="!!set"
t_omap="!!omap"
t_pairs="!!pairs"
t_binary="!!binary"
t_timestamp="!!timestamp"
t_value="!!value"
t_yaml="!!yaml"
t_python="!!python/object:x"
t_local="!local"
t_named="!e!suffix"
t_verbatim="!<tag:yaml.org,2002:str>"
t_verbatim_local="!<!local>"
t_verbatim_empty="!<>"
t_verbatim_unterminated="!<tag:"
t_pct_escape="!%21tag"
t_pct_bad="!%zz"
t_utf8="!\xc3\xa9"
t_on_seq="!!seq [a]"
t_on_map="!!map {a: b}"
t_str_int="!!int abc"

# ── resolved values (core / 1.1 schema) ──────────────────────────────────────
v_null="null"
v_null_caps="NULL"
v_null_title="Null"
v_tilde="~"
v_true="true"
v_false="false"
v_true_caps="TRUE"
v_false_caps="FALSE"
v_yes="YES"
v_no="NO"
v_on="on"
v_off="off"
v_y="y"
v_n="n"
v_int="12345"
v_int_neg="-0"
v_int_plus="+30_123"
v_int_us="1_000_000"
v_oct_1_2="0o17"
v_oct_1_1="0123"
v_hex="0x_1F_2E"
v_bin="0b1010_0111"
v_sexagesimal="190:20:30"
v_int_huge="99999999999999999999999999999999"
v_int_min="-9223372036854775808"
v_float="6.8523015e+5"
v_float_exp="e+03"
v_float_neg_exp="1.2e-99"
v_float_sexa="190:20:30.15"
v_float_huge="1e999999999"
v_float_lead_dot=".5"
v_inf=".inf"
v_neg_inf="-.Inf"
v_nan=".NaN"
v_dot="."
v_zero_e="0e5"
v_ts_date="2001-12-14"
v_ts_full="2001-12-14t21:59:43.10-05:00"
v_ts_space="2001-12-14 21:59:43.10 -5"
v_ts_zulu="2001-12-15T02:59:43.1Z"
v_b64="R0lGODlhDAAMAIQAAP//9/X1"
v_binary_val="!!binary \"R0lGODlhDAAMAIQ=\""

# ── comments ─────────────────────────────────────────────────────────────────
c_hash="#"
c_inline=" # comment"
c_line="# comment\x0a"
c_bare="#\x0a"
c_after_value="k: v # c\x0a"
c_before_doc="# c\x0a---\x0a"
c_in_flow="[a, # c\x0a b]"
c_between_key="k:\x0a# c\x0a v\x0a"

# ── encoding / unicode edge cases ────────────────────────────────────────────
u_bom_utf8="\xef\xbb\xbf"
u_bom_utf16le="\xff\xfe"
u_bom_utf16be="\xfe\xff"
u_bom_utf32le="\xff\xfe\x00\x00"
u_bom_utf32be="\x00\x00\xfe\xff"
u_nul="\x00"
u_ctrl="\x01\x02\x03"
u_del="\x7f"
u_nel="\xc2\x85"
u_nbsp="\xc2\xa0"
u_c1="\xc2\x9f"
u_line_sep="\xe2\x80\xa8"
u_para_sep="\xe2\x80\xa9"
u_replacement="\xef\xbf\xbd"
u_noncharacter="\xef\xbf\xbe"
u_emoji="\xf0\x9f\x98\x80"
u_plane16_max="\xf4\x8f\xbf\xbf"
u_stray_cont="\x80"
u_overlong="\xc0\xaf"
u_truncated="\xe2\x80"
u_encoded_surrogate="\xed\xa0\x80"
u_five_byte="\xf8\x88\x80\x80\x80"
u_out_of_range="\xf5\x80\x80\x80"

# ── JSON (FYPCF_JSON_AUTO / FYPCF_JSON_FORCE) ────────────────────────────────
j_object="{\"a\": 1}"
j_array="[1, 2.5, null]"
j_nested="{\"a\":{\"b\":[]}}"
j_escape="\"\\u0000\""
j_number="-1.5e-3"
j_dup_keys="{\"a\":1,\"a\":2}"

# ── ypath expressions (fy_path_expr_build_from_string / fy_path_exec) ────────
y_slash="/"
y_root="/^"
y_this="/."
y_parent="/.."
y_every_child="/*"
y_every_child_r="/**"
y_key="/key"
y_chain="/a/b/c"
y_seq_index="[0]"
y_seq_index_neg="[-1]"
y_seq_slice="[0:2]"
y_seq_slice_open="[:]"
y_scalar_filter="$"
# ("%" collection filter, ">" gt, "@" and "." are already covered above)
y_sibling=":"
y_barbar="||"
y_ampamp="&&"
y_eqeq="=="
y_noteq="!="
y_lt="<"
y_lte="<="
y_gte=">="
y_lparen="("
y_rparen=")"
y_plus="+"
y_minus="-"
y_bang_path="!/a"
y_bangbang_path="!!/a"
y_m_test="test("
y_m_sum="sum("
y_m_any="any("
y_m_all="all("
y_m_select="select("
y_m_this="this()"
y_m_parent="parent()"
y_m_root="root()"
y_m_key="key()"
y_m_value="value()"
y_m_index="index()"
y_m_null="null()"
y_cond="/**/(key()==\"a\")"
y_arith="(1 + 2) * 3"
y_alias_ref="*a/b"
y_quoted_key="/\"a b\""
y_complex_key="/[a, b]"
y_multi="/a,/b"
y_filter_chain="/**$"
y_map_filter_chain="/*{}"
y_seq_filter_chain="/*[]"
y_unique_chain="/**!"

# ── JSON pointer / relative JSON pointer (fy_node_by_path FYNWF_PTR_*) ───────
p_json="/a/0"
p_json_escape_tilde="~0"
p_json_escape_slash="~1"
p_json_bad_escape="~2"
p_json_index="/0/0/0"
p_reljson="0/a"
p_reljson_hash="1#"
p_reljson_up="2/"
p_yaml_rel="a/b"
p_dotdot=".."

# ── fy_document_scanf() format fragments ─────────────────────────────────────
sc_int="%d"
sc_long="%ld"
sc_float="%f"
sc_char="%c"
sc_hex="%x"
sc_string="%1023s"
sc_star="%*d"
sc_percent="%%"
sc_n="%n"
sc_path_fmt="/a %d"

# ── two-part inputs (first '\n' splits doc from path/format) ─────────────────
split_nl="\x0a"
split_path_doc="/a\x0aa: 1\x0a"
split_ypath_doc="/**\x0a[1, 2]\x0a"
split_json_ptr="/0\x0a[1, 2]\x0a"
split_scanf="/a %d\x0aa: 1\x0a"
split_alias_doc="*a\x0a&a v\x0a"

# ── packed reflection blob (fy_reflection_from_packed_blob) ââââââââ
r_magic="FYPG"
r_sig="FYPG\x01\x00\x00\x00\x00"
r_header="\x46\x59\x50\x47\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00"
