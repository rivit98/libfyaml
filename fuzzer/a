#!/usr/bin/env bash
# libfyaml fuzzing - one entry point for the whole campaign.
#
#   ./a <command> [options]
#
# Commands live in lib/<command>.sh and are sourced, not exec'd, so they share
# the configuration, the logging and the backend plumbing in lib/common.sh.
# Run ./a help for the list, or ./a <command> --help for one.

set -euo pipefail

FUZZ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
LIB_DIR="$FUZZ_ROOT/lib"
export FUZZ_ROOT LIB_DIR
PROG="$(basename "${BASH_SOURCE[0]:-$0}")"

COMMANDS=(build seeds run status stop triage cmin coverage clean)

usage() {
  cat <<USAGE
$PROG <command> [options]

  build       build the harness variants (fast asan cmplog msan tsan lsan cov)
  seeds       build the seed corpus, minimized with afl-cmin
  run         start the multi-core campaign in tmux
  status      campaign dashboard and health checks (--loop, --json)
  stop        stop the campaign
  triage      replay saved artifacts through every built variant
  cmin        minimize the campaign queue for the next run
  coverage    coverage report (cov-analysis), or --edges for the AFL-only metric
  clean       remove builds, logs, coverage, state or crashes

  help        this text

The AFL++ toolchain needs no setup: FUZZ_BACKEND=auto (the default) uses a
local AFL++ when there is one and the docker image otherwise, pulling it on
first use. Force one with FUZZ_BACKEND=docker or FUZZ_BACKEND=host.

Seeds and campaign state are per group (FUZZ_GROUP=yaml|path|scanf|blob|meta),
so groups can run side by side; TC=<test case> restricts a run to one of them.

Common environment: FUZZ_BACKEND=auto|docker|host, FUZZ_GROUP=<group>,
TC=<test case>, JOBS=<n>, FUZZ_DIR=<path>.
See README.md for the campaign layout and src/fuzz/CLAUDE.md for triage.
USAGE
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  help|-h|--help) usage; exit 0 ;;
esac

found=0
for c in "${COMMANDS[@]}"; do [ "$c" = "$cmd" ] && found=1; done
if [ "$found" -eq 0 ]; then
  echo "$PROG: unknown command '$cmd'" >&2
  echo >&2
  usage >&2
  exit 1
fi

# common.sh resolves the backend and defines log()/die()/afl_run()/...
# shellcheck source=lib/common.sh
source "$LIB_DIR/common.sh"

# The command file runs top to bottom with "$@" as its arguments, exactly as a
# standalone script would - including its own exit status.
# shellcheck source=/dev/null
source "$LIB_DIR/$cmd.sh"
